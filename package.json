{
  "name": "muralha-td",
  "private": true,
  "version": "1.0.0",
  "description": "Muralha TD - tower defense em TypeScript + Canvas 2D (evolução do jogo original em URL/QR)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "balance": "vitest run tests/simulation.test.ts --reporter=verbose",
    "decode": "node original/decode.mjs"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
